# Database (Prisma CLI + Next.js both read this)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Google Generative AI (Gemini)
GOOGLE_API_KEY=""
# Optional: override default model (default: gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"

# Firecrawl
FIRECRAWL_API_KEY=""
# Optional: cap Firecrawl credits consumed per scan run
FIRECRAWL_MAX_CREDITS_PER_SCAN=500
# Optional but strongly recommended: shared secret for the Firecrawl agent
# webhook (/api/webhooks/firecrawl?token=...). When unset, the endpoint only
# accepts callbacks whose agent job id matches a scan already in the database.
FIRECRAWL_WEBHOOK_SECRET=""

# Vercel Blob (for storing generated CV PDFs)
BLOB_READ_WRITE_TOKEN=""

# Public app URL (used for Firecrawl webhooks). Set on Vercel automatically; for local dev use ngrok/Vercel.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
